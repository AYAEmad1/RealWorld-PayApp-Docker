@'
# Local environment overrides (src/.env belongs to the original project and stays tracked)
.env.local
.env*.local

# Dependencies and build output
node_modules/
build/
coverage/
.nyc_output/

# Docker local overrides
docker-compose.override.yml

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
'@ | Set-Content -Encoding utf8 .gitignore